# Slack app (Socket Mode). See README.md for the manifest.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# The one channel the bridge watches. Each top-level message = a new session; each thread = one session.
SLACK_CHANNEL_ID=C0123456789
# Comma-separated Slack user IDs allowed to talk to sessions and approve tool calls. Required.
SLACK_ALLOWED_USERS=U0123456789
# Where Slack-started sessions run when the message doesn't begin with a directory.
CLAUDE_SLACK_DEFAULT_CWD=~/projects
# Optional. User OAuth Token (xoxp-) with the user scope chat:write. Lets "purge" delete
# your own messages too. Without it only the bot's messages are removed.
SLACK_USER_TOKEN=

# Admin page (세션 목록·종료·정리). 기본은 이 기계에서만 열립니다.
# 휴대폰 등 다른 기기에서 보려면 HOST 를 0.0.0.0 으로 바꾸고 TOKEN 을 반드시 정하세요.
# CLAUDE_SLACK_WEB=0        # 끄기
# CLAUDE_SLACK_WEB_PORT=4180
# CLAUDE_SLACK_WEB_HOST=127.0.0.1
# CLAUDE_SLACK_WEB_TOKEN=

# 모든 세션은 기본으로 `--chrome`(Claude in Chrome) 을 켜고 시작합니다. 끄려면:
# CLAUDE_SLACK_NO_CHROME=1

# QA 스윕 전용 채널. 설정하면 `scripts/qa-sweep.ts` 가 브로커가 그리는 카드를 그 채널에 실제로 올려
# Slack 이 블록을 받아주는지까지 검사하고, 채널 주입 경로(broker → shim → MCP)도 확인한다.
# 반드시 라이브 채널이 아닌 별도 채널이어야 하고, 봇을 초대해 둬야 한다.
# CLAUDE_SLACK_QA_CHANNEL=C0123456789

# ── 선택: 관리 페이지를 Dokploy(Traefik) 뒤에 도메인으로 붙일 때만 ──
# scripts/dokploy-proxy.ts · dokploy-cert.ts · issue-cert · renew-cert.ts 가 읽는다. 브로커 본체는 쓰지 않는다.
# CLAUDE_SLACK_WEB_DOMAIN=claude-slack.example.com
# CLAUDE_SLACK_PROXY_TARGET=http://100.x.y.z:4180      # 브로커 관리 페이지 주소 (Tailscale IP 등)
# CLAUDE_SLACK_DOKPLOY_APP_ID=                          # 프록시 역할을 하는 Dokploy 앱 ID
# CLAUDE_SLACK_DOKPLOY_APP_NAME=                        # 그 앱의 appName
# CLAUDE_SLACK_DOKPLOY_ORG_ID=                          # 인증서를 올릴 Dokploy 조직 ID
# DOKPLOY_URL= / DOKPLOY_API_KEY=                       # 비우면 ~/.claude.json 의 dokploy MCP 서버 env 를 쓴다
